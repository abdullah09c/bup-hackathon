# Copy to .env (never commit .env). Only names are listed here; no secret values.

# Primary LLM (OpenAI-compatible). Presets: gemini | commandcode | openai | groq | openrouter | agentrouter | stub
LLM_PROVIDER=groq
LLM_API_KEY=
# Model or comma-separated list rotated round-robin; optional @reasoning_effort per model
LLM_MODEL=openai/gpt-oss-120b@low,qwen/qwen3.8-27b@none,openai/gpt-oss-20b@low
# Optional: base URL (required for providers without a preset)
LLM_BASE_URL=
# Optional: e.g. "none" / "low" for faster reasoning models (sent as reasoning_effort)
LLM_REASONING_EFFORT=

# Fallback tiers (optional, OpenAI-compatible), tried in order when the primary fails
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b@low,qwen/qwen3.8-27b@none
LLM_FALLBACK_BASE_URL=

LLM_FALLBACK2_PROVIDER=gemini
LLM_FALLBACK2_API_KEY=
LLM_FALLBACK2_MODEL=gemini-3.5-flash-lite
# Optional extra HTTP headers for the fallback as a JSON object
LLM_FALLBACK_HEADERS=

# Timeouts (seconds)
LLM_TIMEOUT_SECONDS=10
LLM_REQUEST_BUDGET_SECONDS=20

PORT=8000
LOG_LEVEL=INFO
